POSTGRES_USER=polyflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=polyflow
# Local OpenAI-compatible chat endpoint for the AI tutor (Ollama, llama.cpp, vLLM),
# e.g. http://host.docker.internal:11434/v1. Empty = no model, curriculum explanations only.
LLM_URL=
LLM_MODEL=qwen2.5:7b-instruct
# Only for endpoints that require one
LLM_API_KEY=
LLM_TIMEOUT_S=60
# true allows a host outside localhost/private networks (learner text leaves the house)
LLM_ALLOW_REMOTE=false
# true lets child profiles receive validated model text (otherwise curriculum text only)
LLM_FOR_CHILDREN=false
LOG_LEVEL=INFO
# STT model: tiny | base | small | medium | large-v3-turbo (see docs/HARDWARE.md)
WHISPER_MODEL=small
# auto | cpu | cuda (cuda needs docker-compose.gpu.yml)
WHISPER_DEVICE=auto
WHISPER_QUEUE_TIMEOUT_S=30
# Backend wall-clock budget for the Whisper request (CPU decode and queue headroom included)
STT_TIMEOUT_S=120
# Optional, only for gated or rate-limited model downloads
HF_TOKEN=
