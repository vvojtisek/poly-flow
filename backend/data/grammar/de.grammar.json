     "text": "Der Hund spielt im Garten.",
     "cs": "Pes si hraje na zahradě."
    },
    {
     "text": "Das Mädchen liest ein Buch.",
     "cs": "Dívka čte knihu."
    },
    {
     "text": "Die Zeitung liegt auf dem Tisch.",
     "cs": "Noviny leží na stole."
    }
   ],
